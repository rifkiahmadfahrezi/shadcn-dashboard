{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "sortPackageJson": false,
  "sortTailwindcss": {
    "stylesheet": "./app/globals.css",
    "functions": ["classnames", "clsx", "ctl", "cva", "cn"]
  },
  "ignorePatterns": [
    ".next",
    "node_modules",
    "build",
    "dist",
    "out",
    "bun.lock",
    "public"
  ]
}
